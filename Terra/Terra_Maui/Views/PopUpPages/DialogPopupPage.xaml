<?xml version="1.0" encoding="utf-8" ?>
<rg:PopupPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
              xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:rg="clr-namespace:Mopups.Pages;assembly=Mopups"
              x:Class="Terra_Maui.Views.PopUpPages.DialogPopupPage">

    <Frame VerticalOptions="Center" HorizontalOptions="FillAndExpand" CornerRadius="5" Margin="20,20,20,20">
        <StackLayout BackgroundColor="White" Padding="0, 0, 0, 0">
            <Label x:Name="titleLbl" FontSize="20" TextColor="#EF4736" FontAttributes="Bold" VerticalOptions="Start" HorizontalOptions="Center"></Label>
            <StackLayout Margin="5">
                <StackLayout>
                    <StackLayout Orientation="Horizontal">
                        <Entry x:Name="inputEntry"
                   HorizontalOptions="FillAndExpand"
                   IsEnabled="{Binding Path=IsToggled}" 
                   PlaceholderColor="Silver" 
                   Keyboard="Email"
                   TextColor="Gray"></Entry>

                    </StackLayout>


                    <Button Text="SAVE" BackgroundColor="#EF4736" Margin="0,20,0,0" Clicked="Button_Clicked" HorizontalOptions="CenterAndExpand" TextColor="White" CornerRadius="5"
                            FontAttributes="Bold" HeightRequest="50" WidthRequest="90" FontSize="15"></Button>
                </StackLayout>
            </StackLayout>
        </StackLayout>
    </Frame>
</rg:PopupPage>