<?xml version="1.0" encoding="utf-8" ?>
<card:Card xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Terra_Maui.Controls.Week.TimePickerCard"
             xmlns:card="clr-namespace:Terra_Maui.Controls.Week;assembly=Terra_Maui">
    <card:Card>
        <StackLayout Margin="-15" HorizontalOptions="CenterAndExpand">
            <Label x:Name="Title" FontAttributes="Bold" TextColor="White" FontSize="Large" HorizontalOptions="CenterAndExpand"/>
            <Label x:Name="Desc" FontAttributes="Bold" TextColor="White" FontSize="Large" HorizontalOptions="CenterAndExpand"/>
        </StackLayout>
    </card:Card>
</card:Card>